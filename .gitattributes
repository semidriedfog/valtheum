# Normalize project text across Windows and Unix checkouts.
* text=auto eol=lf
*.ps1 text eol=crlf

# Preserve upstream files and test vectors byte for byte. Their manifests and
# interoperability tests verify hashes; do not apply newline conversions here.
static/vendor/** -text
licenses/** -text
tests/fixtures/** -text

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
*.xz binary
*.zst binary
*.wasm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.bcmap binary
*.icc binary
*.vta binary
*.key binary
